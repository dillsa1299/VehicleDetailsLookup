<MudPaper Class="@_statusClass" Height="50%">
    <div class="vertically-stack-elements">
        <MudText Align="Align.Center" Typo="Typo.h4"><b>MOT Status</b></MudText>
        <MudText Align="Align.Center" Typo="Typo.h4">@_statusText</MudText>

        @if (!string.IsNullOrWhiteSpace(_dateText))
        {
            <MudText Align="Align.Center" Typo="Typo.h6">@_dateText</MudText>
        }
    </div>
</MudPaper>