@inherits VehicleLookupStateComponentBase
@using VehicleDetailsLookup.Client.State
@if (LookupState.Vehicle.MotTests.Any())
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var test in LookupState.Vehicle.MotTests)
        {
            <MotHistoryItem Mot="@test"></MotHistoryItem>
        }
    </MudExpansionPanels>
}
