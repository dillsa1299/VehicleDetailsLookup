@if (IsSearching)
{
    <div class="center-elements">
        <MudSkeleton Class="rounded-lg" SkeletonType="SkeletonType.Rectangle" Width="600px" Height="300px" />
    </div>
}
else
{
    <MudCarousel @ref="carouselRef" Class="carousel" ShowArrows="true" ShowBullets="false" AutoCycle="false" TData="object">
        <PreviousButtonTemplate>
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowLeft" Color="Color.Primary" Size="Size.Large" OnClick="MovePrevious" />
        </PreviousButtonTemplate>
        <NextButtonTemplate>
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" Color="Color.Primary" Size="Size.Large" OnClick="MoveNext" />
        </NextButtonTemplate>

        <ChildContent>
            @if (Images.Any())
            {
                @foreach (var image in Images)
                {
                    
                    <MudCarouselItem Transition="Transition.Fade" Color="@Color.Transparent">
                        <div class="center-elements carousel-slide">
                                <MudImage Height="300" Class="rounded-lg carousel-image" Src="@image.Url" FallbackSrc="@PlaceholderImage" Alt="@image.Title" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center" />
                                <div class="image-counter">
                                    <MudText>@image.Index / @Images.Count()</MudText>
                                </div>
                            </div>
                    </MudCarouselItem>
                }
            }
            else
            {
                // Placeholder image if no images are available
                <MudCarouselItem Transition="Transition.Fade" Color="@Color.Transparent">
                    <div class="center-elements">
                        <MudImage Height="300" Src="@PlaceholderImage" FallbackSrc="@PlaceholderImage" Alt="Placeholder car" Class="rounded-lg" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center" />
                    </div>
                </MudCarouselItem>
            }
        </ChildContent>
    </MudCarousel>
}