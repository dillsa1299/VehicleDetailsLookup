<MudPaper Style="@_style" Class="text-element" Height="50%">
    <div class="vertically-stack-elements">
        <MudText Align="Align.Center" Typo="Typo.h4"><b>Tax Status</b></MudText>
        <MudText Align="Align.Center" Typo="Typo.h4">@_statusText</MudText>

        @if (Details?.TaxDueDate != null)
        {
            <MudText Align="Align.Center" Typo="Typo.h6">@ExpiryDateText</MudText>
        }
    </div>
</MudPaper>