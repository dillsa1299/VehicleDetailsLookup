@inherits VehicleLookupStateComponentBase
@using VehicleDetailsLookup.Client.Components.Enums
@using VehicleDetailsLookup.Client.Components.UI.Infrastructure
@using VehicleDetailsLookup.Client.Components.UI.VehicleDetails.ImageViewer
@using VehicleDetailsLookup.Client.Components.UI.VehicleDetails.Lookups.LookupCount
@using VehicleDetailsLookup.Client.Components.UI.VehicleDetails.MotHistory
@using VehicleDetailsLookup.Client.Components.UI.VehicleDetails.MotStatus
@using VehicleDetailsLookup.Client.Components.UI.VehicleDetails.TaxStatus

@if ((Vehicle != null && Vehicle.Details != null) || IsSearchingDetails)
{
    <div class="standard-spacing">
        <ImageViewer Images="@Vehicle?.Images" PlaceholderImage="@_placeholderImage" IsSearching="@(IsSearchingImages || IsSearchingDetails)" />
    </div>

    <div class="standard-spacing">
        @if (IsSearchingDetails)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" md="8">
                    <MudSkeleton Class="rounded-lg" SkeletonType="SkeletonType.Rectangle" Height="400px" Width="100%"></MudSkeleton>
                </MudItem>

                <MudItem xs="12" md="4" Class="sidebar-column">
                    <MudStack Spacing="2" Class="sidebar-stack">
                        <MudSkeleton Class="rounded-lg" SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%"></MudSkeleton>
                        <MudSkeleton Class="rounded-lg" SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%"></MudSkeleton>
                    </MudStack>
                </MudItem>
                <MudItem xs="12">
                    <MudSkeleton Class="rounded-lg" SkeletonType="SkeletonType.Rectangle" Height="100px" Width="100%"></MudSkeleton>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" md="8">
                    <MudPaper Class="text-element">
                        <div class="details-header">
                            <div class="details-title">
                                <MudText Typo="Typo.h3">@Vehicle?.Details?.YearOfManufacture @Vehicle?.Details?.Make @Vehicle?.Details?.Model</MudText>
                            </div>
                            <div class="details-lookup">
                                <LookupCount RegistrationNumber="@Vehicle?.Details?.RegistrationNumber"></LookupCount>
                            </div>
                        </div>

                        <MudText Typo="Typo.h4">Details</MudText>

                        <MudTable Dense="true" Bordered="false" Striped="false" Elevation="0" Class="my-2" Breakpoint="Breakpoint.None" Items="@(new[] { Vehicle })">
                            <RowTemplate>
                                <MudTr>
                                    <MudTd>Colour</MudTd>
                                    <MudTd>@context?.Details?.Colour</MudTd>
                                </MudTr>
                                <MudTr>
                                    <MudTd>Engine capacity</MudTd>
                                    <MudTd>@context?.Details?.EngineCapacity</MudTd>
                                </MudTr>
                                <MudTr>
                                    <MudTd>Fuel</MudTd>
                                    <MudTd>@context?.Details?.FuelType</MudTd>
                                </MudTr>
                                <MudTr>
                                    <MudTd>First registered</MudTd>
                                    <MudTd>@context?.Details?.MonthOfFirstRegistration.ToString("MMMM yyyy")</MudTd>
                                </MudTr>
                                <MudTr>
                                    <MudTd>Last V5C issued</MudTd>
                                    <MudTd>@context?.Details?.DateOfLastV5CIssued</MudTd>
                                </MudTr>
                            </RowTemplate>
                        </MudTable>

                        <MudText Class="mt-4" Typo="Typo.h4">AI Overview</MudText>
                        @if (IsSearchingAiOverview)
                        {
                            <TextSkeletonLoader></TextSkeletonLoader>
                        }
                        else
                        {
                            @if (AiOverviewHtml != null)
                            {
                                <div class="ai-html">
                                    @(AiOverviewHtml)
                                </div>
                            }
                            else
                            {
                                <div class="vertically-align-elements">
                                    <MudText>@_aiFailedMessage</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="@(() => StartLookup(VehicleLookupType.AiOverview))" Class="ml-2" />
                                </div>
                            }
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4" Class="sidebar-column">
                    <MudStack Spacing="2" Class="sidebar-stack">
                        <MotStatus Details="@Vehicle?.Details"></MotStatus>
                        <TaxStatus Details="@Vehicle?.Details"></TaxStatus>
                    </MudStack>
                </MudItem>

                <MudItem xs="12">
                    <MudExpansionPanels Class="rounded-lg" MultiExpansion="true">
                        <MudExpansionPanel Class="px-4" ExpandedChanged="@OnCommonIssuesExpandedAsync">
                            <TitleContent>
                                <MudText Typo="Typo.h4">Common Issues</MudText>
                            </TitleContent>
                            <ChildContent>
                                @if (IsSearchingAiCommonIssues)
                                {
                                    <TextSkeletonLoader></TextSkeletonLoader>
                                }
                                else
                                {
                                    @if (AiCommonIssuesHtml != null)
                                    {
                                        <div class="ai-html">
                                            @(AiCommonIssuesHtml)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="vertically-align-elements">
                                            <MudText>@_aiFailedMessage</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="@(() => StartLookup(VehicleLookupType.AiCommonIssues))" Class="ml-2" />
                                        </div>
                                    }
                                }
                            </ChildContent>
                        </MudExpansionPanel>

                        @if (Vehicle != null && Vehicle.MotTests.Any())
                        {
                            <MudExpansionPanel Class="px-4" ExpandedChanged="@OnMotHistoryExpandedAsync">
                                <TitleContent>
                                    <MudText Typo="Typo.h4">MOT History</MudText>
                                </TitleContent>
                                <ChildContent>
                                    <MudText Typo="Typo.h5">AI Summary</MudText>

                                    @if (IsSearchingAiMotHistorySummary)
                                    {
                                        <TextSkeletonLoader></TextSkeletonLoader>
                                    }
                                    else
                                    {
                                        @if (AiMotHistorySummaryHtml != null)
                                        {
                                            <div class="ai-html">
                                                @(AiMotHistorySummaryHtml)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="vertically-align-elements">
                                                <MudText>@_aiFailedMessage</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="@(() => StartLookup(VehicleLookupType.AiMotHistorySummary))" Class="ml-2" />
                                            </div>
                                        }
                                    }

                                    <MotHistory></MotHistory>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudItem>
            </MudGrid>
        }
    </div>
}